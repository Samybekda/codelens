# Configuration CodeLens (Optionnelle mais recommandée)
# Un token GitHub personnel (Personal Access Token - 'public_repo' ou sans scope spécial)
# permet de passer la limite de 60 requêtes/heure à 5000 requêtes/heure sur l'API GitHub.
# Pour l'utiliser : copiez ce fichier sous le nom '.env' et insérez votre token.
GITHUB_TOKEN=

# Clé secrète pour les sessions et messages Flash de Flask
SECRET_KEY=codelens-dev-secret-key-miage-2026

# Configuration de la base de données SQLite
DATABASE_PATH=codelens.db
